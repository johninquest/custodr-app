# Custodr — Environment Configuration
# Copy this file to .env and fill in your values
#
# NOTE: this file is a template only. Never commit a real .env.
# Secrets are owned by the human; agents must not read or write them.

# ---------------------------------------------------------------------------
# Shared
# ---------------------------------------------------------------------------

# Database (PostgreSQL 18 — encryption at rest via filesystem LUKS/dm-crypt)
# Used by the NestJS API (apps/api-nest).
DATABASE_URL=postgres://pguser:pgpassword@localhost:5432/pgdb?sslmode=disable

# Frontend origin, used for CORS
FRONTEND_URL=http://localhost:5173

# Logging: debug, info, warn, error
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# NestJS API (apps/api-nest)
# ---------------------------------------------------------------------------

# Runtime environment: development, production, test
NODE_ENV=development

# Port the API listens on
PORT=8080

# Firebase Auth. When unset and NODE_ENV is not "production", the API uses a
# development AuthProvider that accepts the fixed DEV_AUTH_TOKEN below, so
# protected routes can be exercised locally without a Firebase project.
FIREBASE_PROJECT_ID=your-project-id
# Service-account credentials (replaces the old firebase-service-account.json
# file). Set all three to use real Firebase auth. private_key is a PEM string;
# use \n for line breaks.
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Development-only bearer token. Only used when Firebase is unset AND
# NODE_ENV !== "production". Choose any non-empty value; never commit a real
# token or reuse a production secret here.
DEV_AUTH_TOKEN=

# Email (Mailjet) — DEFERRED. Documented for completeness; no implementation
# is required for the Go -> NestJS cutover. See docs/api_spec.md.
MAILJET_API_KEY=
MAILJET_API_SECRET=
MAILJET_FROM_EMAIL=noreply@example.com
MAILJET_FROM_NAME=Custodr
