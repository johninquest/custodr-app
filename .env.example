# Commitment Manager — Environment Configuration
# Copy this file to .env and fill in your values

# Server
SERVER_PORT=8080
SERVER_HOST=0.0.0.0

# Database (SQLite + SQLCipher)
DB_PATH=./data/commitmgr.db
DB_ENCRYPTION_KEY=  # Generate with: openssl rand -hex 32

# Firebase Auth
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CREDENTIALS_PATH=./firebase-service-account.json

# Email (Mailjet)
MAILJET_API_KEY=
MAILJET_API_SECRET=
MAILJET_FROM_EMAIL=noreply@example.com
MAILJET_FROM_NAME=Commitment Manager

# Logging
LOG_LEVEL=debug  # debug, info, warn, error
