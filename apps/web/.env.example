# Frontend Environment Configuration
# Copy this file to .env and fill in your values
#
# Vite loads env files in this order (later wins):
#   .env  <  .env.[mode]  <  .env.[mode].local
# `vite dev` uses mode "development"; `npm run build` uses mode "production".
#
# Layout used by this project:
#   .env                -> VITE_FIREBASE_* only (this file; per-developer)
#   .env.development    -> VITE_API_BASE_URL=/api/v1
#   .env.production     -> VITE_API_BASE_URL=https://api.<domain>/api/v1
#
# Why the split: the Vite dev proxy (`server.proxy` in vite.config.ts) only
# exists during `vite dev`. A relative "/api/v1" would 404 on Firebase Hosting,
# so the production build must use the absolute API origin.
#
# NOTE: VITE_* values are compiled into the public JS bundle. Never put a
# secret behind a VITE_ prefix.

# Firebase Configuration
# Get these values from your Firebase project settings:
# https://console.firebase.google.com/project/_/settings/general
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id
