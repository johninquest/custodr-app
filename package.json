{
  "name": "custodr-app",
  "version": "0.1.0",
  "private": true,
  "description": "Commitment Management Platform - Track renewals, deadlines, and recurring commitments",
  "packageManager": "npm@11.16.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:api": "npm run dev --workspace=api-nest",
    "dev:web": "npm run dev --workspace=web",
    "dev:nest": "turbo run dev --filter=api-nest --filter=web",
    "build": "turbo run build",
    "build:api": "npm run build --workspace=api-nest",
    "build:web": "npm run build --workspace=web",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "clean": "turbo run clean",
    "db:generate": "npm run db:generate --workspace=api-nest",
    "db:migrate": "npm run db:migrate --workspace=api-nest",
    "stop": "node scripts/kill-ports.mjs 8080 5173",
    "stop:api": "node scripts/kill-ports.mjs 8080",
    "stop:web": "node scripts/kill-ports.mjs 5173"
  },
  "devDependencies": {
    "kill-port-process": "^4.0.2",
    "turbo": "^2.0.0"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "firebase": "^12.16.0"
  },
  "engines": {
    "node": ">=20.19.0",
    "npm": ">=9.0.0"
  }
}
